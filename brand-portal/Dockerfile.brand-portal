FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.0.6 --activate

WORKDIR /app

# First, copy only the files needed for dependency installation
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/ ./packages/
COPY AthleteID/backend/package.json ./AthleteID/backend/
COPY AthleteID/brand-portal/package.json ./AthleteID/brand-portal/
COPY AthleteID/main/package.json ./AthleteID/main/

# Install all dependencies
RUN pnpm install --frozen-lockfile

# Copy the application source code
COPY AthleteID/brand-portal/ ./AthleteID/brand-portal/

# Build the specific application
RUN pnpm --filter athlete-id-brand-portal build

# --- Runner Stage ---
FROM node:20-alpine AS runner
WORKDIR /app

# Copy only the built artifacts from the base stage
COPY --from=base /app/AthleteID/brand-portal/.next/standalone ./
COPY --from=base /app/AthleteID/brand-portal/.next/static ./AthleteID/brand-portal/.next/static
COPY --from=base /app/AthleteID/brand-portal/public ./AthleteID/brand-portal/public

ENV NODE_ENV=production
EXPOSE 3000
CMD ["node", "server.js"]
